+class VSCodeLinkService extends PDFLinkService {
+  #vscode;
+  #resourceRoot;
+
+  constructor(vscode, resourceRoot, ...args) {
+    super(...args);
+    this.#vscode = vscode;
+    this.#resourceRoot = resourceRoot;
+  }
+
+  postMessage(message) {
+    this.#vscode.postMessage(message);
+  }
+
+  addLinkAttributes(link, url, newWindow = false) {
+    super.addLinkAttributes(link, url, newWindow);
+    if (
+      this.externalLinkEnabled &&
+      typeof url === "string" &&
+      typeof this.#resourceRoot === "string" &&
+      url.startsWith(this.#resourceRoot)
+    ) {
+      link.onclick = event => {
+        event.preventDefault();
+        this.#vscode.postMessage({ open: url });
+        return false;
+      };
+    }
+  }
+}
